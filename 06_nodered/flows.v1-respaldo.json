    {
        "id": "fn_estado",
        "type": "function",
        "z": "tab_nodo1",
        "name": "separar latido",
        "func": "const p = msg.payload || {};\nconst hora = new Date().toLocaleTimeString('es-PE');\nreturn [\n    { payload: p.rssi },\n    { payload: p.uptime_s + ' s' },\n    { payload: hora }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [
            [
                "ui_rssi_gauge",
                "ui_rssi_chart"
            ],
            [
                "ui_uptime"
            ],
            [
                "ui_latido"
            ]
        ]
    },
    {
        "id": "fn_lwt",
        "type": "function",
        "z": "tab_nodo1",
        "name": "online / offline",
        "func": "msg.payload = msg.payload === 'online' ? '🟢 En línea' : '🔴 Fuera de línea';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 240,
        "wires": [
            [
                "ui_conexion"
            ]
        ]
    },
    {
        "id": "fn_eventos",
        "type": "function",
        "z": "tab_nodo1",
        "name": "historial (20)",
        "func": "const lista = flow.get('eventos') || [];\nlista.unshift({\n    hora: new Date().toLocaleTimeString('es-PE'),\n    topic: msg.topic,\n    mensaje: typeof msg.payload === 'string' ? msg.payload : JSON.stringify(msg.payload)\n});\nlista.splice(20);\nflow.set('eventos', lista);\nreturn { payload: lista };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 320,
        "wires": [
            [
                "ui_tabla"
            ]
        ]
    },
